# ============================================
# Grad-School-Agent 环境变量模板
# ============================================
# 复制本文件为 .env 并填写真实值。.env 已被 .gitignore 排除。

# === LLM (DeepSeek 默认) ===
LLM_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# === Embedding ===
# 选项 1: DeepSeek（如可用）或 Qwen
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your_qwen_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# 选项 2: 本地 BGE（离线 / 零成本）— 设置后 EMBEDDING_PROVIDER 改为 local
# EMBEDDING_PROVIDER=local
# EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# === 外部工具 API（可选，未配置时降级为静态数据） ===
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# === 应用配置 ===
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
DB_PATH=./data/grad_school.db
CHROMA_PATH=./data/chroma
